#!/bin/bash
# 伴读书童AI - 语音对话启动脚本
# 双击即可运行，不受 opencode 3分钟限制

cd "$(dirname "$0")/.."

# 清屏并显示欢迎信息
clear
echo "============================================================"
echo "  伴读书童AI · 语音对话模式"
echo "============================================================"
echo ""
echo "  使用方法："
echo "    1. 对着麦克风说话"
echo "    2. 书童会听、想、回答、说出来"
echo "    3. 说'退出'或'再见'结束对话"
echo "    4. 按 Ctrl + C 也可以停止"
echo ""
echo "============================================================"
echo ""

# 启动语音对话
".venv/bin/python3" -u "工具脚本/快速语音对话.py"

# 对话结束后暂停，方便查看结果
echo ""
echo "============================================================"
echo "  语音对话已结束"
echo "============================================================"
read -n 1 -s -r -p "按任意键关闭窗口..."
