#!/bin/bash
# 伴读书童AI - 完整版语音对话启动脚本
# 加载完整大脑：发育守护、四医融合、文化传承、体质模型
# 双击即可运行，不受 opencode 3分钟限制

cd "$(dirname "$0")/.."

clear
echo "============================================================"
echo "  伴读书童AI · 完整版语音对话"
echo "============================================================"
echo ""
echo "  本模式加载书童完整大脑："
echo "    • 发育守护引擎"
echo "    • 四医融合引擎"
echo "    • 文化传承引擎"
echo "    • 体质模型"
echo "    • 孩子档案管理"
echo "    • 知识库"
echo ""
echo "  启动约需 20-40 秒，请耐心等待。"
echo ""
echo "  使用方法："
echo "    1. 书童提示'已就位'后，对麦克风说话"
echo "    2. 说'退出'或'再见'结束"
echo "    3. 按 Ctrl + C 也可以停止"
echo ""
echo "============================================================"
echo ""

# 启动完整版语音对话
".venv/bin/python3" -u -m "书童程序.主程序" --voice

# 对话结束后暂停
echo ""
echo "============================================================"
echo "  语音对话已结束"
echo "============================================================"
read -n 1 -s -r -p "按任意键关闭窗口..."
