#!/bin/bash
# 伴读书童AI · 云端服务启动脚本
# 用法：双击运行，或在终端执行 ./启动云端书童.command

cd "$(dirname "$0")"

# 设置环境变量（生产环境请修改这些值）
export PORT=5000
export HOST=0.0.0.0
export MASTER_KEY="master-dev-key"
export DEFAULT_FAMILY_KEY="dev-key-default"
export FLASK_SECRET_KEY="$(openssl rand -hex 32 2>/dev/null || python3 -c 'import secrets; print(secrets.token_hex(32))')"

# 生产环境建议用 gunicorn：
# .venv/bin/gunicorn -w 2 -b $HOST:$PORT cloud_server:app

# 开发环境用 Flask 内置服务器：
.venv/bin/python cloud_server.py
