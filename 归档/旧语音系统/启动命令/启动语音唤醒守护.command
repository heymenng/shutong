#!/bin/bash
# 伴读书童AI - 语音唤醒守护启动脚本
# 双击运行后，书童常驻后台，喊"书童"即可唤醒

cd "$(dirname "$0")"

clear
echo "============================================================"
echo "  伴读书童AI · 语音唤醒守护"
echo "============================================================"
echo ""
echo "  功能："
echo "    • 书童常驻后台"
echo "    • 喊'书童'即可唤醒"
echo "    • 对话结束后继续监听"
echo ""
echo "  说明："
echo "    • 会持续监听麦克风"
echo "    • 所有处理在本地完成"
echo "    • 说'退出守护'可停止"
echo "    • 按 Ctrl + C 也可以停止"
echo ""
echo "============================================================"
echo ""

# 启动唤醒守护
".venv/bin/python3" -u "工具脚本/语音唤醒守护.py"

# 结束后暂停
echo ""
echo "============================================================"
echo "  唤醒守护已结束"
echo "============================================================"
read -n 1 -s -r -p "按任意键关闭窗口..."
